<ui version="4.0">
 <class>RuntimeDialog</class>
 <widget class="QDialog" name="RuntimeDialog">
  <property name="windowTitle"><string>Runtime</string></property>
  <layout class="QVBoxLayout" name="dialogLayout">
   <item>
    <widget class="QGroupBox" name="runtimeBox">
     <property name="minimumSize"><size><width>380</width><height>0</height></size></property>
     <property name="title"><string>Runtime</string></property>
     <layout class="QVBoxLayout" name="runtimeLayout">
      <property name="spacing"><number>5</number></property>
      <property name="leftMargin"><number>8</number></property>
      <property name="topMargin"><number>8</number></property>
      <property name="rightMargin"><number>8</number></property>
      <property name="bottomMargin"><number>8</number></property>
      <item><widget class="QCheckBox" name="lockCheckbox"><property name="text"><string>Lock values continuously (fixes post-round black screen)</string></property></widget></item>
      <item><widget class="QCheckBox" name="lockSelectionCheckbox"><property name="text"><string>Also lock character/stage selection continuously</string></property></widget></item>
      <item><widget class="QCheckBox" name="autoDisableStageLockCheckbox"><property name="text"><string>Auto-disable stage lock once match starts</string></property></widget></item>
      <item>
       <layout class="QHBoxLayout" name="guardRow">
        <item><widget class="QCheckBox" name="guardPauseCheckbox"><property name="text"><string>Pause writes around round transitions</string></property></widget></item>
        <item><widget class="QLabel" name="guardPauseLabel"><property name="text"><string>ms:</string></property></widget></item>
        <item><widget class="QSpinBox" name="guardPauseMsSpin"><property name="minimum"><number>200</number></property><property name="maximum"><number>10000</number></property><property name="singleStep"><number>200</number></property><property name="value"><number>2800</number></property></widget></item>
        <item><spacer name="guardSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
       </layout>
      </item>
      <item><widget class="QCheckBox" name="stabilizeCheckbox"><property name="text"><string>Stabilize writes for ~10s after apply</string></property></widget></item>
      <item><widget class="QCheckBox" name="modeResetPulseCheckbox"><property name="text"><string>Apply mode using reset pulse (4 -&gt; target)</string></property></widget></item>
      <item><widget class="QCheckBox" name="p1ControllerCheckbox"><property name="text"><string>Set P1 state = controller (base+0x12DA338 = 0)</string></property></widget></item>
      <item><widget class="QCheckBox" name="p2CpuCheckbox"><property name="text"><string>Set P2 state = CPU (base+0x12DC7D8 = 1)</string></property></widget></item>
      <item><widget class="QCheckBox" name="countersCheckbox"><property name="text"><string>Force round counters (offsets 0x290 and 0x29C)</string></property></widget></item>
      <item>
       <layout class="QHBoxLayout" name="counterRow">
        <property name="leftMargin"><number>20</number></property>
        <item><widget class="QLabel" name="p1CounterLabel"><property name="text"><string>P1:</string></property></widget></item>
        <item><widget class="QSpinBox" name="p1CounterSpin"><property name="maximum"><number>99</number></property></widget></item>
        <item><widget class="QLabel" name="p2CounterLabel"><property name="text"><string>P2:</string></property></widget></item>
        <item><widget class="QSpinBox" name="p2CounterSpin"><property name="maximum"><number>99</number></property></widget></item>
        <item><spacer name="counterSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
